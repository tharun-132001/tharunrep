{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "moviesource",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "input-folder//movie.txt"
					},
					{
						"name": "Destination",
						"value": "movies"
					}
				],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "no",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "no",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "hero",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "hero",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "movie",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "movie",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "heroine",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "heroine",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "verdict",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "verdict",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "startdate",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "startdate",
									"type": "Date",
									"physicalType": "date"
								}
							},
							{
								"source": {
									"name": "enddate",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "enddate",
									"type": "Date",
									"physicalType": "date"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_mvsource",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_mvsink",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}